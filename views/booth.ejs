<%- include('partials/header') %>
<div class="spread"><h1>Tempe Feed booth</h1>
  <form method="get" class="row"><label class="row" style="font-weight:400">Requested on
    <select name="day" onchange="this.form.submit()" style="width:auto"><option value="">All open</option><% for (const d of days) { %><option <%= d === day ? 'selected' : '' %>><%= d %></option><% } %></select></label></form></div>
<div class="grid-2">
<section class="card">
  <h2 style="margin-top:0">New request at the booth</h2>
  <form method="post" action="/booth" class="stack" id="boothform">
    <%- include('partials/csrf') %>
    <div class="fields"><label>Name<input name="name" required></label><label>Phone<input name="phone" type="tel"></label></div>
    <div id="items">
      <div class="fields"><label>Item<input name="item" placeholder="e.g. Shoes" required></label><label>Size / details<input name="details" placeholder="e.g. men's 10, black"></label></div>
    </div>
    <button type="button" class="small" onclick="const d=document.querySelector('#items .fields').cloneNode(true);d.querySelectorAll('input').forEach(i=>{i.value='';i.required=false});document.getElementById('items').appendChild(d)">+ another item</button>
    <label>Notes<input name="notes"></label>
    <button class="primary">Save request</button>
  </form>
</section>
<section class="card">
  <h2 style="margin-top:0">How this board works</h2>
  <p class="small">Requested → someone buys it (they press <b>Bought</b>, which drafts a text to the person) → it goes on the board at the booth (<b>At Booth</b>) → the person collects it (<b>Picked Up</b>). Use <b>←</b> to move an item back a step if it was moved by mistake. Items are held for <%= holdWeeks %> weeks after the request. After that the card turns red so you can cancel it.</p>
</section>
</div>
<% if (expired.length) { %>
<section class="card expired-box">
  <h2 style="margin-top:0">⚠ <%= expired.length %> <%= expired.length === 1 ? 'item has' : 'items have' %> waited at the booth more than <%= holdWeeks %> weeks</h2>
  <p class="small">These weren't picked up in time. Cancel them, or move them back if the person is still coming.</p>
  <% for (const r of expired) { %>
    <div class="row" style="align-items:center;margin-top:6px">
      <span><b><%= r.Item %></b> for <%= r.Name %> · requested <%= r.Date %> (<%= hold[r.ID].weeks %> weeks ago)</span>
      <form method="post" action="/booth/<%= r.ID %>" class="inline"><%- include('partials/csrf') %><input type="hidden" name="to" value="Cancelled"><input type="hidden" name="day" value="<%= day %>"><button class="small">Cancel it</button></form>
    </div>
  <% } %>
</section>
<% } %>
<div class="board">
<% for (const lane of lanes) { %>
  <div class="lane"><h3><%= lane.status %> <span class="muted"><%= lane.rows.length %></span></h3>
  <% for (const r of lane.rows) { %>
    <div class="ticket<%= hold[r.ID].expired ? ' expired' : '' %>">
      <% if (hold[r.ID].expired) { %><span class="tag">⚠ Over <%= holdWeeks %> weeks, cancel?</span><% } else if (r.Status === 'At Booth') { %><span class="tag ok">Week <%= Math.min(hold[r.ID].weeks + 1, holdWeeks) %> of <%= holdWeeks %></span><% } %>
      <b><%= r.Item %></b><% if (r.Details) { %><span class="small"><%= r.Details %></span><br><% } %>
      <span class="small"><%= r.Name %> · <%= r.Phone %></span>
      <br><span class="small muted">Requested <%= String(r.Date || '').slice(0, 10) %></span>
      <% if (r['Handled By']) { %><br><span class="small muted">Bought by <%= r['Handled By'] %></span><% } %>
      <div class="row" style="margin-top:6px">
        <% const back = { Bought: 'Requested', 'At Booth': 'Bought', 'Picked Up': 'At Booth', Cancelled: 'Requested' }[r.Status]; %>
        <% if (back) { %><form method="post" action="/booth/<%= r.ID %>" class="inline"><%- include('partials/csrf') %><input type="hidden" name="to" value="<%= back %>"><input type="hidden" name="day" value="<%= day %>"><button class="small" title="Move back to <%= back %>">← <%= r.Status === 'Cancelled' ? 'Restore' : back %></button></form><% } %>
        <% const next = { Requested: ['Bought'], Bought: ['At Booth'], 'At Booth': ['Picked Up'] }[r.Status] || []; %>
        <% for (const n of next.concat(r.Status === 'Picked Up' || r.Status === 'Cancelled' ? [] : ['Cancelled'])) { %>
          <form method="post" action="/booth/<%= r.ID %>" class="inline"><%- include('partials/csrf') %><input type="hidden" name="to" value="<%= n %>"><input type="hidden" name="day" value="<%= day %>"><button class="small <%= n === 'Cancelled' ? '' : 'primary' %>" title="<%= n === 'Cancelled' ? 'Cancel' : 'Move to ' + n %>"><%= n === 'Cancelled' ? '✕' : n + ' →' %></button></form>
        <% } %>
        <% if (admin && r.Phone && r.Status !== 'Requested') { %><a class="btn wa small" target="_blank" href="<%= L.waLink(r.Phone, texts[r.ID]) %>">Text</a><% } %>
      </div>
    </div>
  <% } %>
  </div>
<% } %>
</div>
<div id="live" class="toast" hidden>Someone else just made changes. <a href="">Refresh</a></div>
<script>
  // Several people use the board at once during Tempe Feed: pick up their changes.
  (() => {
    let seen = null;
    const form = document.getElementById('boothform');
    const busy = () => [...form.querySelectorAll('input:not([type=hidden]):not([type=date])')].some((i) => i.value.trim()) || form.contains(document.activeElement);
    const check = async () => {
      try {
        const { v } = await (await fetch('/booth/version', { headers: { 'x-requested-with': 'fetch' } })).json();
        if (seen && v !== seen) {
          if (busy()) document.getElementById('live').hidden = false;
          else return location.reload();
        }
        seen = v;
      } catch {}
    };
    check();
    setInterval(check, 10000);
  })();
</script>
<%- include('partials/footer') %>
