<%- include('partials/header') %>
<section class="card narrow">
  <h1>Sign in</h1>
  <p class="muted">Volunteers and coordinators sign in with their phone number (or name) and PIN.</p>
  <form method="post" action="/login" class="stack">
    <%- include('partials/csrf') %>
    <input type="hidden" name="next" value="<%= next %>">
    <label>Phone number or name<input name="who" required autocomplete="username"></label>
    <label>PIN<input name="pin" type="password" inputmode="numeric" required autocomplete="current-password"></label>
    <button class="btn primary">Sign in</button>
  </form>
  <p class="muted small">New volunteer? <a href="/join">Sign up here</a>. Need a care package? <a href="/request">Request one</a>.</p>
</section>
<%- include('partials/footer') %>
