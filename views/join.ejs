<%- include('partials/header') %>
<section class="card narrow">
  <h1>Volunteer sign up</h1>
  <p class="muted">A coordinator approves new volunteers before they can sign in.</p>
  <form method="post" action="/join" class="stack">
    <%- include('partials/csrf') %>
    <label>Your name<input name="name" required></label>
    <label>Phone (for WhatsApp/text)<input name="phone" type="tel" required></label>
    <label>Email (optional)<input name="email" type="email"></label>
    <label>Choose a PIN (4+ digits)<input name="pin" type="password" inputmode="numeric" minlength="4" required></label>
    <button class="btn primary">Sign up</button>
  </form>
</section>
<%- include('partials/footer') %>
