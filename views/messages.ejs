<%- include('partials/header') %>
<div class="spread"><h1>Messages</h1><a href="/messages<%= all ? '' : '?all=1' %>"><%= all ? 'Show only ready to send' : 'Show all' %></a></div>
<p class="muted small"><%= auto ? 'Automatic texting is ON: messages are sent by SMS as soon as they are created.' : 'The app drafts these whenever a delivery is claimed, delivered, or a booth item is bought. Tap WhatsApp or Text to send from your phone, then mark it sent.' %></p>
<% if (!msgs.length) { %><div class="card"><p class="muted">Nothing waiting to be sent.</p></div><% } %>
<% for (const m of msgs) { %>
<div class="card">
  <div class="spread"><b><%= m.To %> · <%= m.Phone %></b><span class="small muted"><%= m.Time %> · <%= m.Ref %> · <%= m.Status %></span></div>
  <p style="white-space:pre-wrap"><%= m.Body %></p>
  <div class="row">
    <a class="btn wa small" target="_blank" href="<%= L.waLink(m.Phone, m.Body) %>">WhatsApp</a>
    <a class="btn small" href="<%= L.smsLink(m.Phone, m.Body) %>">Text</a>
    <% for (const to of ['Sent', 'Skipped']) { if (m.Status === to) continue; %>
    <form method="post" action="/messages/<%= m.idx %>" class="inline"><%- include('partials/csrf') %><input type="hidden" name="to" value="<%= to %>"><% if (all) { %><input type="hidden" name="all" value="1"><% } %><button class="small <%= to === 'Sent' ? 'primary' : '' %>">Mark <%= to.toLowerCase() %></button></form>
    <% } %>
  </div>
</div>
<% } %>
<%- include('partials/footer') %>
